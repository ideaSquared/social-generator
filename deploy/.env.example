# Copy to .env (which git ignores) and fill in. Never commit the real values.

# The sheet's ID: the long part of its URL between /d/ and /edit.
SHEET_ID=

# Tab to read.
SHEET_TAB=Social posts

# Set to 0 to stop the tool filling in "Assets made".
SHEET_WRITE_BACK=1

# Only if you are NOT using a service account: a "Publish to web" CSV link. Leave SHEET_ID empty in that case.
SHEET_CSV_URL=

# How often to look at the sheet, and which port the review page is on.
CHECK_EVERY_MINUTES=60
REVIEW_PORT=8087
